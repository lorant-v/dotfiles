{{- $name := "Lorant Vrinceanu" -}}
{{- $email := "lorant.vrinceanu@gmail.com" -}}

{{- $osID := .chezmoi.os -}}
{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{-   $isWSL = .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- end -}}

{{- $profiles := promptMultichoice
    "Which profiles to enable"
    (list "personal" "homelab")
    (list)
-}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  platform:
    osID: {{ $osID | quote }}
    isWSL: {{ $isWSL }}
  
  profiles: {{ $profiles | toJson }}
  use_ansible: false

bitwarden:
  unlock: auto