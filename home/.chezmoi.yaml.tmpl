{{- $name := "Lorant Vrinceanu" -}}
{{- $email := "lorant.vrinceanu@gmail.com" -}}

{{- $os := .chezmoi.os -}}
{{- $distro := "" -}}
{{- $isWSL := false -}}
{{- if eq $os "linux" -}}
  {{- $distro = .chezmoi.osRelease.id -}}
  {{- $isWSL = .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- end -}}

{{- $profiles := promptMultichoice "Which profiles to enable"
    (list "homelab")
    (list)
-}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  platform:
    os: {{ $os | quote }}
    distro: {{ $distro | quote }}
    isWSL: {{ $isWSL }}
  
  profiles: {{ $profiles | toJson }}
  use_ansible: false

{{ if ne $os "windows" }}
hooks:
  read-source-state:
    pre:
      command: .local/share/chezmoi/home/.bootstrap.sh
{{- end -}}