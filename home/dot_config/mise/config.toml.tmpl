[tools]
bitwarden = "latest"

# python
uv = { 
  version = "latest", 
  postinstall = { run = "uv python install --default", when = "always" }
}

# node
node = "lts"
"npm:@opencode/cli" = {
  version = "latest",
  allow_builds = ["@opencode/cli"],
}
{{ if ne .platform.osID "windows" -}}
"npm:@anthropic-ai/sandbox-runtime" = "latest"
{{ end -}}

{{ if has "homelab" .profiles -}}
# homelab
opentofu = "latest"
packer = "latest"
"pypi:ansible" = "latest"
{{- end }}
