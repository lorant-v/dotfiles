{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": true,
  "permission": {
    "*": "ask", // Default, wins last defined 
    "webfetch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "ls *": "allow",
      "rm *": "deny",
      "grep *": "allow"
    },
  },
  "websearch": {
    "provider": "exa"
  }
  "watcher": {
    "ignore": [
      ".git/**",
      ".next/**",
      ".cache/**",
      "coverage/**",
      "dist/**",
      "build/**",
      "node_modules/**"
    ]
  }
}
