{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": true,
  "permission": {
    "*": "allow", // Default, wins last defined 
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "ls *": "allow",
      "rm *": "deny",
      "grep *": "allow"
    },
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".next/**",
      ".cache/**",
      "coverage/**",
      "dist/**",
      "build/**",
      "node_modules/**"
    ]
  }
}
