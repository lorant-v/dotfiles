#!/bin/sh
set -eu
echo "[chezmoi] Running script: copy Windows host .ssh into WSL"

if [ "{{ .wsl.isWSL }}" != "true" ]; then
  echo "[chezmoi] Not running in WSL, skipping"
  exit 0
fi

if [ "{{ .wsl.copyHostSSH }}" != "true" ]; then
  echo "[chezmoi] WSL host .ssh copy not requested, skipping"
  exit 0
fi

windows_user='{{ .wsl.windowsUser }}'

if [ -z "$windows_user" ]; then
  echo "[chezmoi] No Windows username configured, skipping" >&2
  exit 0
fi

source_dir="/mnt/c/Users/$windows_user/.ssh"
target_dir="$HOME/.ssh"

if [ ! -d "$source_dir" ]; then
  echo "[chezmoi] Source directory not found: $source_dir" >&2
  exit 0
fi

if [ -e "$target_dir" ]; then
  echo "[chezmoi] Target already exists at $target_dir, not overwriting"
  exit 0
fi

cp -R "$source_dir" "$target_dir"
chmod 700 "$target_dir"
find "$target_dir" -type d -exec chmod 700 {} \;
find "$target_dir" -type f -exec chmod 600 {} \;
find "$target_dir" -type f -name '*.pub' -exec chmod 644 {} \;

echo "[chezmoi] Copied $source_dir to $target_dir"
